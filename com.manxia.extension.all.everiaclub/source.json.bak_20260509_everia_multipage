{
  "metadata": {
    "id": "com.manxia.extension.all.everiaclub",
    "name": "Everia.club",
    "type": "manga",
    "version": "2.0.0",
    "language": "all",
    "baseUrl": "https://everia.club",
    "description": "Everia.club - 图片写真",
    "author": "ManXia Team",
    "nsfw": true,
    "tags": [
      "gallery",
      "webview",
      "all-language"
    ],
    "Internet": true
  },
  "capabilities": {
    "urlResolver": true,
    "pagination": true,
    "errorRetry": true,
    "loginSupport": false
  },
  "network": {
    "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
    "timeout": 30000,
    "retryCount": 3,
    "retryDelay": 2000,
    "headers": {
      "Referer": "https://everia.club/"
    }
  },
  "workflows": {
    "popular": {
      "description": "获取热门漫画列表（从侧边栏热门帖子）",
      "supportsPagination": false,
      "actions": [
        {
          "type": "navigate",
          "url": "{{baseUrl}}/",
          "timeout": 15000,
          "description": "导航到首页"
        },
        {
          "type": "wait",
          "condition": "element",
          "selector": ".wli_popular_posts-class li",
          "timeout": 10000,
          "description": "等待热门列表加载"
        },
        {
          "type": "script",
          "code": "(() => { const mangas = []; const items = document.querySelectorAll('.wli_popular_posts-class li'); items.forEach((item) => { const img = item.querySelector('img'); const h3 = item.querySelector('h3'); const link = item.querySelector('h3 > a'); if (img && h3 && link) { const cover = img.getAttribute('data-lazy-src') || img.getAttribute('data-src') || img.getAttribute('src') || ''; const title = h3.textContent?.trim() || ''; const href = link.getAttribute('href') || ''; const id = href.replace(/^https?:\\/\\/(www\\.)?everia\\.club/i, '').replace(/^\\//, '').replace(/\\/$/, ''); if (title && id) { mangas.push({ id: id, title: title, cover: cover }); } } }); return JSON.stringify(mangas); })();",
          "description": "提取热门漫画列表"
        }
      ]
    },
    "latest": {
      "description": "获取最新漫画列表",
      "supportsPagination": true,
      "actions": [
        {
          "type": "script",
          "code": "(() => { const page = Number('{{page}}' || 1); return page <= 1 ? '{{baseUrl}}/' : '{{baseUrl}}/page/' + page + '/'; })();",
          "description": "构建最新列表页面 URL"
        },
        {
          "type": "navigate",
          "url": "{{scriptResult}}",
          "timeout": 15000,
          "description": "导航到最新页面"
        },
        {
          "type": "wait",
          "condition": "element",
          "selector": "#blog-entries > article, #content > article",
          "timeout": 10000,
          "description": "等待文章列表加载"
        },
        {
          "type": "script",
          "code": "(() => { const mangas = []; const articles = document.querySelectorAll('#blog-entries > article, #content > article'); articles.forEach((article) => { const img = article.querySelector('img'); const titleEl = article.querySelector('.entry-title'); const linkEl = article.querySelector('.entry-title > a'); if (img && titleEl && linkEl) { const cover = img.getAttribute('data-lazy-src') || img.getAttribute('data-src') || img.getAttribute('src') || ''; const title = titleEl.textContent?.trim() || ''; const href = linkEl.getAttribute('href') || ''; const id = href.replace(/^https?:\\/\\/(www\\.)?everia\\.club/i, '').replace(/^\\//, '').replace(/\\/$/, ''); if (title && id) { mangas.push({ id: id, title: title, cover: cover }); } } }); return JSON.stringify(mangas); })();",
          "description": "提取最新漫画列表"
        }
      ]
    },
    "search": {
      "description": "搜索漫画",
      "supportsPagination": true,
      "actions": [
        {
          "type": "script",
          "code": "(() => { const page = Number('{{page}}' || 1); const keyword = encodeURIComponent('{{searchKeyword}}'); return page <= 1 ? '{{baseUrl}}/?s=' + keyword : '{{baseUrl}}/page/' + page + '/?s=' + keyword; })();",
          "description": "构建搜索页面 URL"
        },
        {
          "type": "navigate",
          "url": "{{scriptResult}}",
          "timeout": 15000,
          "description": "导航到搜索页面"
        },
        {
          "type": "wait",
          "condition": "element",
          "selector": "#blog-entries > article, #content > article",
          "timeout": 10000,
          "description": "等待搜索结果加载"
        },
        {
          "type": "wait",
          "condition": "time",
          "duration": 1000,
          "description": "等待页面完全渲染"
        },
        {
          "type": "script",
          "code": "(() => { const mangas = []; const articles = document.querySelectorAll('#blog-entries > article, #content > article'); articles.forEach((article) => { const img = article.querySelector('img'); const titleEl = article.querySelector('.entry-title'); const linkEl = article.querySelector('.entry-title > a'); if (img && titleEl && linkEl) { const cover = img.getAttribute('data-lazy-src') || img.getAttribute('data-src') || img.getAttribute('src') || ''; const title = titleEl.textContent?.trim() || ''; const href = linkEl.getAttribute('href') || ''; const id = href.replace(/^https?:\\/\\/(www\\.)?everia\\.club/i, '').replace(/^\\//, '').replace(/\\/$/, ''); if (title && id) { mangas.push({ id: id, title: title, cover: cover }); } } }); return JSON.stringify(mangas); })();",
          "description": "提取搜索结果"
        }
      ]
    },
    "getMangaDetail": {
      "description": "获取漫画详情",
      "actions": [
        {
          "type": "navigate",
          "url": "https://everia.club/{{mangaId}}/",
          "timeout": 15000,
          "description": "导航到漫画详情页"
        },
        {
          "type": "wait",
          "condition": "element",
          "selector": ".entry-title",
          "timeout": 10000,
          "description": "等待详情加载"
        },
        {
          "type": "script",
          "code": "(() => { const title = document.querySelector('.entry-title')?.textContent?.trim() || ''; const description = title; const tags = Array.from(document.querySelectorAll('.post-tags > a')).map((el) => (el.textContent || '').trim()).filter(Boolean); const genre = tags.join(', '); const cover = document.querySelector('.entry-content img')?.getAttribute('data-lazy-src') || document.querySelector('.entry-content img')?.getAttribute('data-src') || document.querySelector('.entry-content img')?.getAttribute('src') || ''; return JSON.stringify({ title: title, cover: cover, author: '', status: 'completed', description: description, genre: genre }); })();",
          "description": "提取漫画详情"
        }
      ]
    },
    "getChapterList": {
      "description": "获取章节列表",
      "actions": [
        {
          "type": "navigate",
          "url": "https://everia.club/{{mangaId}}/",
          "timeout": 15000,
          "description": "导航到漫画详情页"
        },
        {
          "type": "wait",
          "condition": "element",
          "selector": ".entry-title",
          "timeout": 10000,
          "description": "等待详情加载"
        },
        {
          "type": "script",
          "code": "(() => { const canonical = document.querySelector('link[rel=\"canonical\"]'); const href = canonical ? canonical.getAttribute('href') : window.location.href; const id = href.replace(/^https?:\\/\\/(www\\.)?everia\\.club/i, '').replace(/^\\//, '').replace(/\\/$/, ''); let date = ''; const dateMatch = href.match(/\\d{4}\\/\\d{2}\\/\\d{2}/); if (dateMatch) { date = dateMatch[0]; } return JSON.stringify([{ id: id, title: 'Gallery', publishTime: date }]); })();",
          "description": "提取章节列表（每个画廊只有一个章节）"
        }
      ]
    },
    "getPageList": {
      "description": "获取章节图片列表",
      "actions": [
        {
          "type": "navigate",
          "url": "https://everia.club/{{chapterId}}/",
          "timeout": 20000,
          "description": "导航到画廊页面"
        },
        {
          "type": "wait",
          "condition": "element",
          "selector": ".entry-content img",
          "timeout": 15000,
          "description": "等待图片加载"
        },
        {
          "type": "script",
          "code": "(() => { document.querySelectorAll('noscript').forEach((el) => el.remove()); const pageLinks = document.querySelectorAll('.page-links a.post-page-numbers'); const allUrls = []; if (pageLinks.length > 0) { const urls = []; pageLinks.forEach((a) => { const href = a.getAttribute('href'); if (href && !urls.includes(href)) urls.push(href); }); return JSON.stringify({ type: 'multiPage', urls: urls }); } const images = document.querySelectorAll('.entry-content img'); images.forEach((img, index) => { const src = img.getAttribute('data-lazy-src') || img.getAttribute('data-src') || img.getAttribute('src') || ''; if (src && !src.startsWith('data:image')) { allUrls.push({ index: index, url: src }); } }); return JSON.stringify({ type: 'singlePage', pages: allUrls }); })();",
          "description": "提取图片列表（支持多分页）"
        }
      ]
    },
    "getPageListMultiPage": {
      "description": "获取多分页画廊的图片列表",
      "actions": [
        {
          "type": "navigate",
          "url": "{{pageUrl}}",
          "timeout": 20000,
          "description": "导航到分页页面"
        },
        {
          "type": "wait",
          "condition": "element",
          "selector": ".entry-content img",
          "timeout": 15000,
          "description": "等待图片加载"
        },
        {
          "type": "script",
          "code": "(() => { document.querySelectorAll('noscript').forEach((el) => el.remove()); const pages = []; const images = document.querySelectorAll('.entry-content img'); images.forEach((img, index) => { const src = img.getAttribute('data-lazy-src') || img.getAttribute('data-src') || img.getAttribute('src') || ''; if (src && !src.startsWith('data:image')) { pages.push({ index: index, url: src }); } }); return JSON.stringify(pages); })();",
          "description": "提取单个分页的图片列表"
        }
      ]
    },
    "getImageUrl": {
      "description": "获取图片URL（直接返回）",
      "actions": [
        {
          "type": "script",
          "code": "(() => { return '{{imageUrl}}'; })();",
          "description": "返回图片URL"
        }
      ]
    },
    "filter": {
      "description": "筛选画廊（支持分类筛选）",
      "supportsPagination": true,
      "defaults": {
        "category": ""
      },
      "actions": [
        {
          "type": "script",
          "code": "(() => { const page = Number('{{page}}' || 1); const category = '{{category}}'.trim(); if (!category) { return page <= 1 ? '{{baseUrl}}/' : '{{baseUrl}}/page/' + page + '/'; } return page <= 1 ? '{{baseUrl}}/category/' + category + '/' : '{{baseUrl}}/category/' + category + '/page/' + page + '/'; })();",
          "description": "构建分类筛选页面 URL"
        },
        {
          "type": "navigate",
          "url": "{{scriptResult}}",
          "timeout": 15000,
          "description": "导航到筛选结果页面"
        },
        {
          "type": "wait",
          "condition": "element",
          "selector": "#blog-entries > article, #content > article",
          "timeout": 10000,
          "description": "等待结果加载"
        },
        {
          "type": "script",
          "code": "(() => { const mangas = []; const articles = document.querySelectorAll('#blog-entries > article, #content > article'); articles.forEach((article) => { const img = article.querySelector('img'); const titleEl = article.querySelector('.entry-title'); const linkEl = article.querySelector('.entry-title > a'); if (img && titleEl && linkEl) { const cover = img.getAttribute('data-lazy-src') || img.getAttribute('data-src') || img.getAttribute('src') || ''; const title = titleEl.textContent?.trim() || ''; const href = linkEl.getAttribute('href') || ''; const id = href.replace(/^https?:\\/\\/(www\\.)?everia\\.club/i, '').replace(/^\\//, '').replace(/\\/$/, ''); if (title && id) { mangas.push({ id: id, title: title, cover: cover }); } } }); return JSON.stringify(mangas); })();",
          "description": "提取筛选结果"
        }
      ]
    }
  },
  "tabs": [
    {
      "id": "popular",
      "type": "popular",
      "name": "热门",
      "enabled": true,
      "order": 0,
      "requiresLogin": false
    },
    {
      "id": "latest",
      "type": "latest",
      "name": "最新",
      "enabled": true,
      "order": 1,
      "requiresLogin": false
    },
    {
      "id": "filter",
      "type": "filter",
      "name": "筛选",
      "enabled": true,
      "order": 2,
      "requiresLogin": false,
      "filterConfig": {
        "title": "筛选画廊",
        "description": "选择筛选条件",
        "groups": [
          {
            "id": "category",
            "title": "分类",
            "defaultValue": "",
            "options": [
              {
                "value": "",
                "label": "全部"
              },
              {
                "value": "china",
                "label": "China"
              },
              {
                "value": "cosplay",
                "label": "Cosplay"
              },
              {
                "value": "japan",
                "label": "Japan"
              },
              {
                "value": "korea",
                "label": "Korea"
              },
              {
                "value": "thailand",
                "label": "Thailand"
              }
            ]
          }
        ]
      }
    }
  ],
  "changelog": [
    {
      "version": "2.0.0",
      "date": "2026-05-09",
      "changes": [
        "重写图源配置，对齐最新仓库 EveriaClub.kt 参考实现",
        "修正 baseUrl 为 everia.club（原 everiaclub.com 为错误站点）",
        "修正所有 CSS 选择器匹配 WordPress 主题结构",
        "修正图片属性优先级：data-lazy-src > data-src > src",
        "修正搜索 URL 格式：?s=keyword + /page/N/ 分页",
