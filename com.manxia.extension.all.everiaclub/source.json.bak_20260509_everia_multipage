        "修正分页 URL 格式：/page/N/",
        "增加多分页画廊支持（.page-links）",
        "增加 noscript 标签清理",
        "修正日期格式为 yyyy/MM/dd"
      ]
    },
    {
      "version": "1.0.0",
      "date": "2026-02-05",
      "changes": [
        "初始版本，移植自keiyoushi Everia扩展",
        "支持热门、最新、搜索功能",
        "支持分类筛选",
        "支持图片懒加载"
      ]
    }
  ]
}
