                                                         "code":  "(() =\u003e {\n  const baseUrl = String(((globalThis \u0026\u0026 globalThis.__baseUrl) || location.origin));\n  const toAbs = (href) =\u003e { try { return new URL(String(href || \u0027\u0027), baseUrl).toString(); } catch (_) { return String(href || \u0027\u0027); } };\n  const results = [];\n  const cards = Array.from(document.querySelectorAll(\u0027z-bookcard\u0027));\n  for (let i = 0; i \u003c cards.length; i += 1) {\n    const card = cards[i];\n    const href = card.getAttribute(\u0027href\u0027) || \u0027\u0027;\n    const fullUrl = toAbs(href);\n    const titleEl = card.querySelector(\u0027[slot=\"title\"]\u0027);\n    const authorEl = card.querySelector(\u0027[slot=\"author\"]\u0027);\n    const img = card.querySelector(\u0027img\u0027);\n    const title = (titleEl?.textContent || \u0027\u0027).trim();\n    const author = (authorEl?.textContent || \u0027\u0027).trim();\n    const cover = img?.getAttribute(\u0027data-src\u0027) || img?.getAttribute(\u0027src\u0027) || \u0027\u0027;\n    const extension = card.getAttribute(\u0027extension\u0027) || \u0027\u0027;\n    const filesize = card.getAttribute(\u0027filesize\u0027) || \u0027\u0027;\n    const year = card.getAttribute(\u0027year\u0027) || \u0027\u0027;\n    results.push({ id: fullUrl, title: title, author: author, cover: cover, url: fullUrl, extension: extension, fileSize: filesize, year: year });\n  }\n  return JSON.stringify(results);\n})();",
