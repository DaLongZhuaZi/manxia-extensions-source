                                                                "type":  "script",
                                                                "code":  "(() =\u003e {\n  const clean = (v) =\u003e String(v || \u0027\u0027).replace(/\\s+/g, \u0027 \u0027).trim();\n  const h1 = document.querySelector(\u0027h1\u0027);\n  const authorEl = document.querySelector(\u0027a[href*=\"/author/\"]\u0027);\n  const categoryEl = document.querySelector(\u0027.property_categories .property_value\u0027);\n  const yearEl = document.querySelector(\u0027.property_year .property_value\u0027);\n  const publisherEl = document.querySelector(\u0027.property_publisher .property_value\u0027);\n  const languageEl = document.querySelector(\u0027.property_language .property_value\u0027);\n  const isbnEl = document.querySelector(\u0027.property_isbn .property_value\u0027);\n\n  const title = clean(h1?.textContent);\n  const author = clean(authorEl?.textContent);\n  const categories = clean(categoryEl?.textContent);\n  const year = clean(yearEl?.textContent);\n  const publisher = clean(publisherEl?.textContent);\n  const language = clean(languageEl?.textContent);\n  const isbn = clean(isbnEl?.textContent);\n\n  let cover = \u0027\u0027;\n  try {\n    const meta = document.querySelector(\u0027meta[property=\"og:image\"], meta[name=\"twitter:image\"]\u0027);\n    if (meta) cover = meta.getAttribute(\u0027content\u0027) || \u0027\u0027;\n  } catch (_) {}\n  if (!cover) {\n    const zCover = document.querySelector(\u0027z-cover\u0027);\n    if (zCover \u0026\u0026 zCover.shadowRoot) {\n      const img = zCover.shadowRoot.querySelector(\u0027img\u0027);\n      if (img) cover = img.getAttribute(\u0027src\u0027) || img.getAttribute(\u0027data-src\u0027) || \u0027\u0027;\n    }\n  }\n  if (!cover) {\n    const img = document.querySelector(\u0027.details-info img, .row img, img[src*=\"cover\"]\u0027);\n    if (img) cover = img.getAttribute(\u0027src\u0027) || img.getAttribute(\u0027data-src\u0027) || \u0027\u0027;\n  }\n\n  const description = [publisher ? `出版社: ${publisher}` : \u0027\u0027, year ? `年份: ${year}` : \u0027\u0027, language ? `语言: ${language}` : \u0027\u0027, isbn ? `ISBN: ${isbn}` : \u0027\u0027].filter(Boolean).join(\u0027 | \u0027);\n\n  return JSON.stringify({\n    id: \u0027\u0027,\n    title: title,\n    author: author,\n    description: description,\n    cover: cover,\n    categories: categories,\n    tags: categories,\n    year: year,\n    publisher: publisher,\n    language: language,\n    isbn: isbn\n  });\n})();",
