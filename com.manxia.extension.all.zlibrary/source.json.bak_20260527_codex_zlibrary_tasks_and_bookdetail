                                                                  "type":  "script",
                                                                  "code":  "(() =\u003e {\n  const result = { debug: { url: location.href, title: document.title }, files: [] };\n  const seen = {};\n  const push = (url, name, fmt, size) =\u003e {\n    const href = String(url || \u0027\u0027).trim();\n    if (!href || href === \u0027#\u0027 || href.startsWith(\u0027javascript:\u0027)) return;\n    if (seen[href]) return;\n    seen[href] = true;\n    result.files.push({ url: href, name: name || fmt.toUpperCase() || \u0027文件\u0027, format: fmt, size: size || \u0027\u0027 });\n  };\n  const anchors = Array.from(document.querySelectorAll(\u0027a[href]\u0027));\n  for (let i = 0; i \u003c anchors.length; i += 1) {\n    const a = anchors[i];\n    const href = a.getAttribute(\u0027href\u0027) || \u0027\u0027;\n    const text = (a.textContent || \u0027\u0027).replace(/\\s+/g, \u0027 \u0027).trim();\n    const m = href.match(/\\.(epub|pdf|mobi|azw3|txt|djvu)(?:\\b|\\?)/i) || text.match(/\\.(epub|pdf|mobi|azw3|txt|djvu)\\b/i);\n    if (m) push(href, text, m[1].toLowerCase(), \u0027\u0027);\n  }\n  if (result.files.length === 0) {\n    const form = document.querySelector(\u0027form[action]\u0027);\n    if (form) {\n      const action = form.getAttribute(\u0027action\u0027) || \u0027\u0027;\n      const method = (form.getAttribute(\u0027method\u0027) || \u0027GET\u0027).toUpperCase();\n      const data = {};\n      const fields = form.querySelectorAll(\u0027input[name],select[name],textarea[name]\u0027);\n      for (let i = 0; i \u003c fields.length; i += 1) {\n        const el = fields[i];\n        const name = el.getAttribute(\u0027name\u0027) || \u0027\u0027;\n        if (!name) continue;\n        data[name] = el.value || el.getAttribute(\u0027value\u0027) || \u0027\u0027;\n      }\n      result.form = { action: action, method: method, data: data };\n    }\n  }\n  console.log(\u0027[extractFileList] files=\u0027 + result.files.length + \u0027 hasForm=\u0027 + !!result.form);\n