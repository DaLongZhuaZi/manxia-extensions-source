                                                                 "type":  "script",
                                                                 "code":  "(() =\u003e {\n  const prefers = String(((globalThis \u0026\u0026 globalThis.__preferredFormat) || \u0027\u0027)).toLowerCase();\n  const buttons = Array.from(document.querySelectorAll(\u0027a[href].dlButton, a[href][class*=dl], button[onclick]\u0027));\n  const candidates = [];\n  for (let i = 0; i \u003c buttons.length; i += 1) {\n    const btn = buttons[i];\n    const href = btn.getAttribute(\u0027href\u0027) || btn.getAttribute(\u0027onclick\u0027) || \u0027\u0027;\n    const text = (btn.textContent || \u0027\u0027).trim();\n    const m = href.match(/\\.(epub|pdf|mobi|azw3|txt|djvu)/i);\n    const format = m ? m[1].toLowerCase() : (text.match(/(epub|pdf|mobi|azw3|txt|djvu)/i) || [\u0027\u0027,\u0027\u0027])[1].toLowerCase();\n    if (href \u0026\u0026 href !== \u0027#\u0027) {\n      candidates.push({ id: String(candidates.length + 1), title: format ? format.toUpperCase() : (text || \u0027下载\u0027), url: href, format: format, order: i + 1, recommended: format === prefers ? 1 : 0 });\n    }\n  }\n  if (candidates.length === 0) {\n    const readerBtn = document.querySelector(\u0027a[href*=\"reader.\"]\u0027);\n    if (readerBtn) {\n      const href = readerBtn.getAttribute(\u0027href\u0027) || \u0027\u0027;\n      if (href) candidates.push({ id: \u00271\u0027, title: \u0027在线阅读\u0027, url: href, format: \u0027\u0027, order: 1, recommended: 0 });\n    }\n  }\n  candidates.sort((a,b) =\u003e (b.recommended - a.recommended) || (a.order - b.order));\n  return JSON.stringify(candidates);\n})();",
