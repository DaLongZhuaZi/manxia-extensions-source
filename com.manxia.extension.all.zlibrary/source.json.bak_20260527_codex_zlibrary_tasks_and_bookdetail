                                                                         "code":  "(() =\u003e {\n  const clean = (v) =\u003e String(v || \u0027\u0027).replace(/\\s+/g, \u0027 \u0027).trim();\n  const toAbs = (v) =\u003e { try { return new URL(String(v || \u0027\u0027), location.href).toString(); } catch (_) { return String(v || \u0027\u0027); } };\n  const prefers = clean(((globalThis \u0026\u0026 globalThis.__preferredFormat) || \u0027\u0027)).toLowerCase();\n  const result = { sources: [], recommendedSourceUrl: null };\n  const seen = {};\n  const add = (name, href, order, format) =\u003e {\n    const url = toAbs(href);\n    if (!url || url === \u0027about:blank\u0027 || url.startsWith(\u0027javascript:\u0027)) return;\n    if (seen[url]) return;\n    seen[url] = true;\n    const rec = format \u0026\u0026 format === prefers ? 1 : 0;\n    result.sources.push({ id: String(result.sources.length + 1), name: name || format.toUpperCase() || \u0027下载\u0027, url: url, format: format, recommended: rec, order: order });\n  };\n  const btns = document.querySelectorAll(\u0027a[href].dlButton, a[href][class*=dl], a[href][class*=download], button[onclick]\u0027);\n  for (let i = 0; i \u003c btns.length; i += 1) {\n    const el = btns[i];\n    const href = el.getAttribute(\u0027href\u0027) || el.getAttribute(\u0027onclick\u0027) || \u0027\u0027;\n    const text = clean(el.textContent);\n    const m = href.match(/\\.(epub|pdf|mobi|azw3|txt|djvu)/i);\n    const fmt = m ? m[1].toLowerCase() : (text.match(/(epub|pdf|mobi|azw3|txt|djvu)/i) || [\u0027\u0027,\u0027\u0027])[1].toLowerCase();\n    add(text || (fmt ? fmt.toUpperCase() : \u0027下载\u0027), href, i + 1, fmt);\n  }\n  if (result.sources.length === 0) {\n    const readerBtn = document.querySelector(\u0027a[href*=\"reader.\"]\u0027);\n    if (readerBtn) add(\u0027在线阅读\u0027, readerBtn.getAttribute(\u0027href\u0027) || \u0027\u0027, 1, \u0027\u0027);\n  }\n  result.sources.sort((a,b) =\u003e (b.recommended - a.recommended) || (a.order - b.order));\n  if (result.sources.length \u003e 0 \u0026\u0026 !result.recommendedSourceUrl) {\n    const best = result.sources.find((s) =\u003e s.recommended === 1) || result.sources[0];\n    result.recommendedSourceUrl = best.url;\n  }\n  console.log(\u0027[waitForDownloadSources] sources=\u0027 + result.sources.length + \u0027 recommended=\u0027 + (result.recommendedSourceUrl || \u0027none\u0027));\n  return JSON.stringify(result);\n})();",
